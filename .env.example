# Скопируйте в apps/web/.env.local и заполните. Реальные значения в git не коммитим.

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) — публичный, защита данных обеспечивается RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Только сервер (Telegram-бот, n8n, cron). Secret key (sb_secret_...) нельзя использовать в клиентском коде
SUPABASE_SECRET_KEY=

# Секрет для вызова /api/fx/refresh планировщиком (n8n/cron): минимум 16 символов, случайный
CRON_SECRET=

# Публичный адрес приложения (для ссылок в боте и setWebhook), например https://family.example.com
APP_URL=http://localhost:3000

# OpenAI: разбор сообщений, голос, чеки, текст отчётов. Без ключа бот работает только с командами.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Telegram: токен от @BotFather, имя бота без @, секрет webhook (16–256 символов A-Z a-z 0-9 _ -)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
EXCHANGE_RATES_API_KEY=
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
