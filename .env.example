# Скопируйте в apps/web/.env.local и заполните. Реальные значения в git не коммитим.

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) — публичный, защита данных обеспечивается RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Только сервер (Telegram-бот, n8n, cron). Secret key (sb_secret_...) нельзя использовать в клиентском коде
SUPABASE_SECRET_KEY=

OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
EXCHANGE_RATES_API_KEY=
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
